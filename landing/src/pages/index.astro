---
import { Image, getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import { CONTACTO, PRECIO, formatearPesos } from '../datos'
import logo from '../assets/frodosoft.svg'

import kineticFicha from '../assets/productos/kinetic-ficha.png'
import kineticFactura from '../assets/productos/kinetic-factura.png'
import kineticCierre from '../assets/productos/kinetic-cierre.jpg'
import vetFicha from '../assets/productos/vetadmin-ficha.png'
import vetTurnos from '../assets/productos/vetadmin-turnos.png'
import vetVentas from '../assets/productos/vetadmin-ventas.png'
import vetMovil from '../assets/productos/vetadmin-movil.png'

// Los mockups son capturas de las apps reales con datos inventados
// (ver marketing/mockups/ en VetAdmin). No reemplazarlos por capturas de
// produccion: tienen nombres de pacientes y clientes reales.
const productos = [
  {
    id: 'kinetic',
    nombre: 'Kinetic',
    bajada: 'Software para consultorios de kinesiología',
    texto:
      'Fichas de pacientes con anamnesis, sesiones, historia clínica, estudios y ART. Factura electrónica a ARCA sin salir de la app, cuenta corriente y control del monotributo.',
    puntos: [
      'Ficha completa de cada paciente, también desde el celular',
      'Factura electrónica a ARCA',
      'Cuenta corriente con obras sociales y ART',
      'Recordatorios de turno por WhatsApp',
    ],
    piezas: [
      { img: kineticFicha, alt: 'Kinetic: la ficha de cada paciente, completa' },
      { img: kineticFactura, alt: 'Kinetic: factura a ARCA sin salir de la app' },
      { img: kineticCierre, alt: 'Kinetic: se adapta a cómo trabaja tu consultorio' },
    ],
  },
  {
    id: 'vetadmin',
    nombre: 'VetAdmin',
    bajada: 'Gestión para clínicas veterinarias',
    texto:
      'Clientes, mascotas e historia clínica con control de peso. Agenda de turnos con recordatorios automáticos por WhatsApp, y caja con ventas, productos y gastos.',
    puntos: [
      'Historia clínica de cada mascota',
      'Recordatorios de turno por WhatsApp',
      'Ventas, stock y gastos',
      'Multiplataforma: computadora, tablet y celular',
    ],
    piezas: [
      { img: vetFicha, alt: 'VetAdmin: historia clínica de la mascota' },
      { img: vetTurnos, alt: 'VetAdmin: la agenda del día, sin planilla ni cuaderno' },
      { img: vetVentas, alt: 'VetAdmin: caja y ventas' },
      { img: vetMovil, alt: 'VetAdmin: desde el celular' },
    ],
  },
]

// Version grande de cada pieza para el visor: el original a 1080 en webp,
// en vez del PNG de 300-400 KB.
for (const p of productos) {
  for (const m of p.piezas) {
    ;(m as any).grande = (await getImage({ src: m.img, width: 1080, format: 'webp' })).src
  }
}

const precio = formatearPesos(PRECIO.mensual)
const waLink = CONTACTO.whatsapp
  ? `https://wa.me/${CONTACTO.whatsapp}?text=${encodeURIComponent('Hola, quiero probar un mes gratis')}`
  : ''
const mailLink = CONTACTO.email ? `mailto:${CONTACTO.email}?subject=${encodeURIComponent('Quiero probar un mes gratis')}` : ''
const hayContacto = Boolean(waLink || mailLink || CONTACTO.instagram)
// Glifo generico de camara (contorno redondeado + lente), como el de Instagram.
const iconoInstagram =
  '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>'
---

<Base
  title="Frodosoft — Software de gestión a medida"
  description="Sistemas de gestión para consultorios y veterinarias: Kinetic y VetAdmin. Primer mes gratis."
>
  <header class="top">
    <div class="wrap top-in">
      <a href="/" class="marca" aria-label="Frodosoft, inicio">
        <Image src={logo} alt="" width={36} height={40} class="marca-logo" />
        <span>Frodosoft</span>
      </a>
      <nav aria-label="Secciones">
        <a href="#soluciones">Soluciones</a>
        <a href="#precio">Precio</a>
        {hayContacto && <a href="#contacto">Contacto</a>}
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <p class="kicker">Software de gestión · a medida</p>
      <h1>Sistemas que se adaptan a cómo trabaja tu negocio</h1>
      <p class="lead">
        Desarrollamos y mantenemos aplicaciones web para consultorios, veterinarias y pymes: fichas, agenda,
        facturación electrónica con ARCA y recordatorios por WhatsApp. Tus datos en servidor propio, con respaldo
        diario.
      </p>
      <div class="acciones">
        <a class="btn" href="#soluciones">Ver soluciones</a>
        <a class="btn ghost" href="#precio">Probá un mes gratis</a>
      </div>
    </section>

    <section id="soluciones" class="wrap seccion">
      <p class="kicker">Soluciones</p>
      <h2>Productos</h2>

      {
        productos.map((p) => (
          <article class="producto" id={p.id}>
            <div class="producto-txt">
              <h3>{p.nombre}</h3>
              <p class="bajada">{p.bajada}</p>
              <p>{p.texto}</p>
              <ul>
                {p.puntos.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <div class="galeria" role="list">
              {p.piezas.map((m, i) => (
                <a
                  class="pieza"
                  href={(m as any).grande}
                  role="listitem"
                  data-grupo={p.id}
                  data-indice={i}
                  aria-label={`Ampliar: ${m.alt}`}
                >
                  <Image src={m.img} alt={m.alt} widths={[360, 540, 720]} sizes="(max-width: 820px) 80vw, 340px" />
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <section id="precio" class="wrap seccion">
      <div class="precio">
        <div>
          <p class="kicker">Suscripción</p>
          <h2>Un precio, todo incluido</h2>
          <p class="precio-num"><strong>{precio}</strong> <span>/ mes por sistema</span></p>
          <p class="nota">Kinetic o VetAdmin: cada sistema se contrata por separado.</p>
          <p class="promo">🎁 Primer mes gratis de prueba</p>
          <p class="nota">Lo usás 30 días completo, y recién después decidís si seguís.</p>
        </div>
        <ul>
          <li>Hosting, dominio seguro (HTTPS) y respaldo diario</li>
          <li>Actualizaciones y soporte</li>
          <li>Ajustes a la medida de tu forma de trabajo</li>
        </ul>
      </div>
    </section>

    {
      hayContacto && (
        <section id="contacto" class="wrap seccion contacto">
          <h2>Empezá tu mes de prueba</h2>
          <p>Contanos cómo trabajás y te lo dejamos andando.</p>
          <div class="acciones">
            {waLink && (
              <a class="btn" href={waLink} target="_blank" rel="noopener">
                Escribinos por WhatsApp
              </a>
            )}
            {CONTACTO.instagram && (
              <a class="btn ghost con-icono" href={CONTACTO.instagram} target="_blank" rel="noopener">
                <Fragment set:html={iconoInstagram} />
                Seguinos en Instagram
              </a>
            )}
            {mailLink && (
              <a class="btn ghost" href={mailLink}>
                {CONTACTO.email}
              </a>
            )}
          </div>
        </section>
      )
    }
  </main>

  <footer class="pie">
    <div class="wrap pie-in">
      <span>© {new Date().getFullYear()} Frodosoft</span>
      <span class="pie-der">
        frodosoft.com.ar
        {CONTACTO.instagram && (
          <a class="pie-ig" href={CONTACTO.instagram} target="_blank" rel="noopener" aria-label="Frodosoft en Instagram">
            <Fragment set:html={iconoInstagram} />
          </a>
        )}
      </span>
    </div>
  </footer>

  <dialog class="visor" aria-label="Imagen ampliada">
    <button class="visor-btn visor-cerrar" type="button" aria-label="Cerrar (Esc)">✕</button>
    <button class="visor-btn visor-prev" type="button" aria-label="Anterior (←)">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="visor-btn visor-next" type="button" aria-label="Siguiente (→)">›</button>
  </dialog>
</Base>

<script>
  // Visor de las piezas: Esc o clic afuera cierra, flechas / botones / deslizar
  // recorren las piezas del MISMO producto. Sin JS, cada pieza abre la imagen
  // grande como link comun.
  const visor = document.querySelector<HTMLDialogElement>('.visor')!
  const img = visor.querySelector('img')!
  const pie = visor.querySelector('figcaption')!
  let grupo: HTMLAnchorElement[] = []
  let actual = 0
  // Entrada de historial propia mientras el visor esta abierto, para que el
  // Atras del celular lo cierre en vez de irse de la pagina.
  let conEntrada = false

  function mostrar(i: number) {
    actual = (i + grupo.length) % grupo.length
    const a = grupo[actual]
    const alt = a.querySelector('img')?.alt ?? ''
    img.src = a.href
    img.alt = alt
    pie.textContent = `${alt} · ${actual + 1} de ${grupo.length}`
  }

  function abrir(a: HTMLAnchorElement) {
    grupo = [...document.querySelectorAll<HTMLAnchorElement>(`.pieza[data-grupo="${a.dataset.grupo}"]`)]
    mostrar(Number(a.dataset.indice))
    visor.showModal()
    // Se conserva el state previo: pisarlo rompe a quien lo use.
    history.pushState({ ...history.state, visor: true }, '')
    conEntrada = true
  }

  document.querySelectorAll<HTMLAnchorElement>('.pieza').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault()
      abrir(a)
    }),
  )

  // 'close' corre con Esc, con la X, con clic afuera y con Atras.
  visor.addEventListener('close', () => {
    if (conEntrada) {
      conEntrada = false
      // Solo si nuestra entrada sigue siendo la actual (no se cerro con Atras).
      if (history.state?.visor) history.back()
    }
  })
  window.addEventListener('popstate', () => {
    if (visor.open) {
      conEntrada = false
      visor.close()
    }
  })

  visor.querySelector('.visor-cerrar')!.addEventListener('click', () => visor.close())
  visor.querySelector('.visor-prev')!.addEventListener('click', () => mostrar(actual - 1))
  visor.querySelector('.visor-next')!.addEventListener('click', () => mostrar(actual + 1))
  // Clic en el fondo (el propio dialog), no en la imagen ni en los botones.
  visor.addEventListener('click', (e) => {
    if (e.target === visor || e.target === visor.querySelector('figure')) visor.close()
  })
  visor.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostrar(actual - 1)
    if (e.key === 'ArrowRight') mostrar(actual + 1)
  })

  let inicioX: number | null = null
  visor.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') inicioX = e.clientX })
  visor.addEventListener('pointerup', (e) => {
    if (inicioX === null) return
    const dx = e.clientX - inicioX
    inicioX = null
    if (Math.abs(dx) > 50) mostrar(actual + (dx < 0 ? 1 : -1))
  })
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: rgba(11, 20, 36, 0.75);
    border-bottom: 1px solid var(--line);
  }
  .top-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 1.1rem; }
  /* El logo de la marca es negro: invertido para el fondo oscuro. */
  .marca-logo { width: 30px; height: auto; filter: invert(1); }
  nav { display: flex; gap: 20px; }
  nav a { text-decoration: none; color: var(--muted); font-weight: 500; font-size: 0.95rem; }
  nav a:hover { color: var(--text); }

  .kicker {
    margin: 0 0 8px;
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero { padding: 96px 0 72px; }
  h1 { font-size: clamp(2.1rem, 6vw, 3.8rem); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 20px; max-width: 16ch; }
  h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); letter-spacing: -0.02em; margin: 0 0 32px; line-height: 1.15; }
  h3 { font-size: 1.8rem; margin: 0; letter-spacing: -0.02em; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 62ch; margin: 0 0 32px; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--accent);
    color: #04201d;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(20, 184, 166, 0.25);
  }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); box-shadow: none; }
  .btn:hover { filter: brightness(1.08); }

  .seccion { padding: 64px 0; border-top: 1px solid var(--line); }
  .producto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 32px 48px;
    align-items: start;
    padding: 32px;
    margin-bottom: 32px;
    background: linear-gradient(180deg, var(--card), var(--bg-2));
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  /* La galeria va abajo, a todo el ancho: las piezas tienen texto chico y
     a media tarjeta no se leen. Tres a la vista, el resto se desliza. */
  .galeria { grid-column: 1 / -1; }
  .bajada { color: var(--accent-ink); font-weight: 600; margin: 4px 0 16px; }
  .producto-txt p { color: var(--muted); }
  .producto-txt .bajada { color: var(--accent-ink); }
  ul { padding: 0; margin: 0; list-style: none; display: grid; gap: 10px; }
  li { position: relative; padding-left: 26px; }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.18);
  }
  /* Riel horizontal con scroll-snap: en celular se desliza de a una pieza. */
  .galeria {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, calc((100% - 32px) / 3));
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    min-width: 0;
  }
  .pieza { scroll-snap-align: start; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
  .pieza img { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.3s; }
  .pieza:hover img { transform: scale(1.02); }
  .pieza { cursor: zoom-in; }

  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }
  .visor[open] { display: flex; align-items: center; justify-content: center; }
  .visor::backdrop { background: rgba(4, 8, 16, 0.88); backdrop-filter: blur(4px); }
  .visor figure { margin: 0; display: grid; gap: 12px; justify-items: center; padding: 56px 72px; touch-action: pan-y; }
  .visor img { max-width: min(90vw, 1080px); max-height: calc(100dvh - 140px); width: auto; height: auto; border-radius: 12px; }
  .visor figcaption { color: var(--muted); font-size: 0.95rem; text-align: center; }
  .visor-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(19, 34, 58, 0.85);
    color: var(--text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .visor-btn:hover { background: var(--accent); color: #04201d; }
  .visor-cerrar { top: 16px; right: 16px; font-size: 1.1rem; }
  .visor-prev { left: 16px; top: 50%; translate: 0 -50%; }
  .visor-next { right: 16px; top: 50%; translate: 0 -50%; }

  .precio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 40px;
    border-radius: var(--radius);
    border: 1px solid rgba(20, 184, 166, 0.4);
    background: radial-gradient(600px 300px at 0% 0%, rgba(20, 184, 166, 0.16), transparent 70%), var(--card);
  }
  .precio h2 { margin-bottom: 16px; }
  .precio-num { margin: 0; font-size: 1.2rem; color: var(--muted); }
  .precio-num strong { font-size: clamp(2.4rem, 6vw, 3.4rem); color: var(--text); letter-spacing: -0.03em; }
  /* En celular "/ mes por sistema" pasa entero a la linea de abajo, no partido. */
  .precio-num span { white-space: nowrap; }
  .precio-num + .nota { margin-top: 8px; }
  .promo {
    display: inline-block;
    margin: 16px 0 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(20, 184, 166, 0.16);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .nota { color: var(--muted); font-size: 0.95rem; margin: 0; }

  .contacto { text-align: center; }
  .contacto h2 { margin-bottom: 8px; }
  .contacto p { color: var(--muted); margin: 0 0 24px; }
  .contacto .acciones { justify-content: center; }

  .pie { border-top: 1px solid var(--line); padding: 28px 0; color: var(--muted); font-size: 0.9rem; }
  .con-icono { gap: 8px; }
  .pie-der { display: inline-flex; align-items: center; gap: 14px; }
  .pie-ig { display: inline-flex; color: var(--muted); }
  .pie-ig:hover { color: var(--accent-ink); }
  .pie-in { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .hero { padding: 56px 0 48px; }
    .producto, .precio { grid-template-columns: 1fr; padding: 22px; gap: 24px; }
    .galeria { grid-auto-columns: 80%; }
    .visor figure { padding: 64px 12px 88px; }
    .visor img { max-width: 100%; }
    .visor-prev, .visor-next { top: auto; bottom: 20px; translate: none; }
    nav { gap: 14px; }
    nav a { font-size: 0.88rem; }
  }
</style>
